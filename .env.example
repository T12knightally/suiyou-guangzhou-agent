# Copy to .env; never commit real keys. Web service keys stay on this server.
AMAP_KEY=
# Qwen: use the same region/workspace as your API key.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
# Optional separate provider; no automatic paid failover.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
